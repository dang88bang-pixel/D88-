<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/simulation_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFF3E0"
            app:cardCornerRadius="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/simulation_banner"
                android:textColor="#E65100"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/D88.SectionTitle"
            android:text="@string/sys_status" />

        <com.google.android.material.card.MaterialCardView
            style="@style/D88.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/D88.StatBox">
                        <TextView style="@style/D88.StatValue" android:id="@+id/stat_devices" android:text="0" />
                        <TextView style="@style/D88.StatLabel" android:text="@string/stat_devices" />
                    </LinearLayout>

                    <LinearLayout style="@style/D88.StatBox">
                        <TextView style="@style/D88.StatValue" android:id="@+id/stat_approvals" android:text="0" />
                        <TextView style="@style/D88.StatLabel" android:text="@string/stat_approvals" />
                    </LinearLayout>

                    <LinearLayout style="@style/D88.StatBox">
                        <TextView style="@style/D88.StatValue" android:id="@+id/stat_sessions" android:text="0" />
                        <TextView style="@style/D88.StatLabel" android:text="@string/stat_sessions" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/stat_roles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/stat_policy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/stat_transport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/D88.SectionTitle"
            android:layout_marginTop="16dp"
            android:text="@string/my_devices" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/devices_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_security"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/btn_security" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_knowledge"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_knowledge" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
